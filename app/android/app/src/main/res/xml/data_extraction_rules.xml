<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" switches off cloud backup everywhere, but on some
     manufacturers' devices it leaves device-to-device transfer on. Nothing
     Golem stores leaves the phone (ADR 0016), so every domain is excluded
     from both paths explicitly; this file is what makes the transfer half
     true. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
