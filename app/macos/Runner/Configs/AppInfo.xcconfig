// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = golem_flutter

// The fallback for a flavorless build, mirroring iOS: the production, qa, dev
// and lab flavors override this per build configuration in the pbxproj, and a
// build that selects no flavor is a qa build.
PRODUCT_BUNDLE_IDENTIFIER = app.golem.qa

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Jan Slominski

// Which window MainFlutterWindow opens (ADR 0021): the consumer flavors keep
// the iPad-shaped `tablet` default; the lab's build configurations override
// this with `desktop`. Info.plist carries it as GolemWindowProfile.
GOLEM_WINDOW_PROFILE = tablet
