# Root-level tooling and OS artifacts; app/.gitignore covers the Flutter
# project itself.
.DS_Store
.idea/
*.iml
*.log
coverage/
.dart_tool/
build/
# The SDK checkout fvm materialises from .fvmrc; the pin is committed,
# the 1 GB of SDK it names is not.
.fvm/

# SwiftPM build output and caches for the Inferno MLX carrier. Neither
# upstream source trees nor compiled libraries belong in git.
.build/
.swiftpm/

# Device-run identity material (private/public key blobs); never commit.
selfIdentity.plist

references/

# Local agent workspace: skills carry machine paths, settings carry local
# permission state.
.claude/
